#!/usr/bin/env bash
# Run the existing dashboard in Herdr's floating terminal, preserving the layout.
set -uo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  ldir="$(CDPATH= cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$ldir/$SOURCE"
done
DIR="$(CDPATH= cd -P "$(dirname "$SOURCE")" && pwd)"
source "$DIR/lib/paths.sh"
source "$DIR/lib/pane.sh"

case "${1:-}" in
  --render)
    # The popup entrypoint already owns a terminal. Preserve plugin credential
    # precedence over the daemon's environment.
    [ "$#" -eq 1 ] || { echo "e2b-popup: --render takes no arguments" >&2; exit 2; }
    export HERDR_PLUGIN_ID="e2b-dev.herdr-e2b"
    export HERDR_PLUGIN_ROOT="$PLUGIN_DIR"
    export HERDR_PLUGIN_CONFIG_DIR="$CONFIG_DIR"
    export HERDR_PLUGIN_STATE_DIR="$STATE_DIR"
    export E2B_DASH_POPUP=1
    exec "$DIR/e2b-dash" ;;
  -h|--help|help)
    cat <<'USAGE'
e2b-popup — the E2B dashboard floating over your Herdr panes

usage
  e2b-popup                  open the dashboard popup
  e2b-box popup              the same popup through the main CLI
  e2b-popup --render         draw inside an existing popup terminal

The same UI and controls as e2b-dash, at 90% width and 85% height.
Enter opens the selected box in a regular pane split below the pane the popup
floats over, and closes the popup. Press q or Esc to close it without opening.
Requires a running Herdr session with this plugin enabled.

Keybinding in Herdr config.toml:
  [[keys.command]]
  key = "prefix+shift+d"
  type = "shell"
  command = 'exec "$HOME/.local/bin/e2b-popup"'
USAGE
    exit 0 ;;
  "") ;;
  *) echo "e2b-popup: unknown argument '$1' — run e2b-popup --help" >&2; exit 2 ;;
esac

HERDR=$(pane_herdr) || { echo "e2b-popup: can't find the herdr binary" >&2; exit 1; }
NODE=$(pane_node) || { echo "e2b-popup: can't find node — set HERDR_E2B_NODE=/path/to/node" >&2; exit 1; }

# Remember the pane the popup floats over. Inside the popup, plugin context and
# focus both name the popup's own pane, so this is the one moment "the pane you
# were at" can be read. The TUI hands it to e2b-box-open when Enter opens a box:
# the shell then lands in a split below that pane instead of inside the overlay,
# whose terminal herdr discards the moment the popup closes.
origin=$(printf '%s' "${HERDR_PLUGIN_CONTEXT_JSON:-}" | "$NODE" "$PLUGIN_DIR/src/pane-parse.js" origin)
if [ "${origin:--}" = "-" ]; then
  read -r origin _ _ <<EOF
$(pane_query "$HERDR" "$NODE" "")
EOF
fi
env_args=(--env E2B_DASH_POPUP=1)
[ "${origin:--}" = "-" ] || env_args+=(--env "E2B_DASH_ORIGIN_PANE=$origin")
"$HERDR" plugin pane open --plugin e2b-dev.herdr-e2b --entrypoint popup \
  --placement popup --width 90% --height 85% "${env_args[@]}" >/dev/null
